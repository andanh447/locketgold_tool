#!name=Locket Gold API Delay
#!desc=Bắt API RevenueCat, delay 15s và báo âm thanh
#!category=Tiện ích

[Script]
# Bắt các endpoint trả về thông tin subscriber và entitlement mapping
RevenueCat_Delay = type=http-response, pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts|product_entitlement_mapping), requires-body=1, max-size=0, script-path=locket_delay.js

[MITM]
hostname = %APPEND% api.revenuecat.com
