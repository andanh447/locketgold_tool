[Script]
CapCutPro = type=http-response,pattern=^https?:\/\/.+(capcut|byteoversea)\.com\/(vip|user)\/v\d\/.+,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/htien07/link-cua-anh/main/capcut_vip.js

