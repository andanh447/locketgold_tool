#!name=CapCut Pro Unlock
#!desc=Mở khóa tính năng Pro CapCut bằng MitM
#!category=VIP
#!author=chill

[Script]
# Bắt gói tin xác thực VIP và phản hồi bằng script đã được chỉnh sửa
CapCut_VIP = type=http-response,pattern=^https?:\/\/.*(capcut|byteoversea|capcutvip)\.(com|net)\/.*(user|vip)\/info,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/andanh447/locketgold_tool/refs/heads/main/capcut.js

[MITM]
# Chặn bắt lưu lượng HTTPS cho các domain của CapCut
hostname = %APPEND% *.capcut.com, *.byteoversea.com, *.capcutvip.com, *.capcutvip.net
