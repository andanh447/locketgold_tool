<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <!-- KHỐI 1: CẤU HÌNH DNS BẺ LÁI LOCKET VỀ MÁY CHỦ CỦA ANH -->
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerURL</key>
                <string>https://dns.dhtien.vn/dns-query</string> <!-- Sửa thành DNS ảo của anh -->
            </dict>
            <key>PayloadDescription</key>
            <string>Định tuyến Locket qua Server ĐHT</string>
            <key>PayloadDisplayName</key>
            <string>Locket DoH Routing</string>
            <key>PayloadIdentifier</key>
            <string>com.dhtien.dns.routing</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>1A2B3C4D-5678-90AB-CDEF-111111111111</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>ProhibitDisablement</key>
            <false/>
        </dict>
        
        <!-- KHỐI 2: CHỨNG CHỈ GỐC (ROOT CA) ĐỂ MITM KHÔNG BỊ LỖI SSL HANDSHAKE -->
        <dict>
            <key>PayloadCertificateFileName</key>
            <string>DHTien_MITM_RootCA.crt</string>
            <key>PayloadContent</key>
            <data>
            MIIDdTCCAl2gAwIBAgILBAAAAAABRE7wQkcwDQYJKoZIhvcNAQELBQAwVzELMAkG
            A1UEBhMCVk4xEDAOBgNVBAgMB1ZpZXROYW0xEDAOBgNVBAcMB1ZpZXROYW0xFDAS
            BgNVBAoMC0hUaWVuIFNlcnZlcjERMA8GA1UEAwwISFRpZW4gQ0EwHhcNMjMxMTAx
            ... (Anh sẽ thay đoạn Base64 này bằng mã Base64 từ file .crt của máy chủ anh) ...
            </data>
            <key>PayloadDescription</key>
            <string>Chứng chỉ giải mã HTTPS tiêm Code Filter</string>
            <key>PayloadDisplayName</key>
            <string>HTien MITM Root CA</string>
            <key>PayloadIdentifier</key>
            <string>com.dhtien.security.root</string>
            <key>PayloadType</key>
            <string>com.apple.security.root</string>
            <key>PayloadUUID</key>
            <string>2B3C4D5E-6789-0ABC-DEF1-222222222222</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
        </dict>
    </array>
    
    <!-- THÔNG TIN TỔNG QUAN HIỂN THỊ KHI NGƯỜI DÙNG CÀI ĐẶT -->
    <key>PayloadDescription</key>
    <string>Mở khóa Locket Gold tự động toàn hệ thống (Bao gồm Filter & AI)</string>
    <key>PayloadDisplayName</key>
    <string>Locket Gold Auto (HTien07)</string>
    <key>PayloadIdentifier</key>
    <string>com.dhtien.locket.autounlock</string>
    <key>PayloadOrganization</key>
    <string>Đinh Hoàng Tiến (chill)</string>
    <key>PayloadRemovalDisallowed</key>
<false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>3C4D5E6F-7890-ABCD-EF12-333333333333</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
